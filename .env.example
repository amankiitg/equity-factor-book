# Copy this file to .env and fill in real values. .env is gitignored and
# is never committed. The names are distinct from credit-trading-lab's so a
# stale shell cannot cross the two paper accounts. Values are set by the
# owner in .env locally and in the Render dashboard; they never appear in
# any committed file, log, artifact, notebook output or test fixture.

# Alpaca paper API key for EFB's own paper account (separate from credit-trading-lab's).
EFB_ALPACA_PAPER_API_KEY=

# Alpaca paper secret key for the same EFB paper account.
EFB_ALPACA_PAPER_SECRET_KEY=

# Direct Postgres connection string to the shared Supabase project, e.g.
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# The dashboard holds a read-only role's string; the cron holds the write role's.
# Never PostgREST (EFB_SUPABASE_URL / EFB_SUPABASE_SECRET_KEY are withdrawn).
EFB_SUPABASE_DB_URL=

# The Postgres schema the live series lives in. Default efb. Never public.
EFB_DB_SCHEMA=efb

# Optional: Supabase project URL for the one-time provisioning script only.
# Never a PostgREST connection; never set on either Render service.
EFB_SUPABASE_PROJECT_URL=

# Optional: Supabase personal access token, only for the one-time provisioning script.
# It is account-wide and must never be set on either Render service.
EFB_SUPABASE_ACCESS_TOKEN=

# "true" runs the morning job in dry run (no order leaves the process); only the
# literal string "false" (any case) goes live paper. Unset, empty, or any other
# spelling resolves to dry run.
EFB_DRY_RUN=true

# The store never falls back on its own. This is the explicit request for the
# local parquet files under live/state/, for a local dry run or the research
# dashboard. The cron leaves it unset, so a missing EFB_SUPABASE_DB_URL there is
# an error rather than a quiet write to a disk the next container never sees.
EFB_STORE=local

# The one email every run sends the owner, through Resend's HTTP API. The key is
# EFB's own, with sending access only, and it is a credential: the cron service
# holds it, nothing else does, and it is never printed, logged or stored in efb.
# The sender falls back to Resend's shared onboarding@resend.dev, which can only
# deliver to the address that owns the Resend account. The recipient must be set
# or the run fails, because a run the owner was not told about did not do its job.
# The subject reads "EFB ok <close> | 150 proposed, none sent | stale 0", or
# "EFB STALE <close> | none proposed | stale 3 (prices)", or
# "EFB ERROR <close> | none proposed | <ExceptionType>".
EFB_RESEND_API_KEY=
EFB_NOTIFY_EMAIL_FROM=
EFB_NOTIFY_EMAIL_TO=
