{
  // The EFB live book monitor on Cloudflare.
  //
  // `npm run deploy` = `vite build && wrangler deploy`, and `build.command` below makes
  // even a bare `wrangler deploy` build first. One Worker serves the built page and one
  // API route. `preview_urls: false` matters: without it the
  // Worker gets a second hostname (the *.workers.dev preview) that Cloudflare
  // Access does not cover, which would put positions outside the policy.
  //
  // `ACCESS_TEAM_DOMAIN` and `ACCESS_AUD` are plain vars, not secrets: they name
  // the Access application, and the Worker verifies the assertion against the
  // team's own certificates rather than trusting a header.
  //
  // The team domain is `amankesar`, not `efb-live`. That is what Cloudflare's own
  // metadata for this hostname says, and it is the name the tokens are signed
  // under, so the Worker's issuer check and its JWKS fetch both need it:
  //
  //   GET /.well-known/cloudflare-access-protected-resource/api/snapshot
  //   {"protected":true,"team_domain":"amankesar.cloudflareaccess.com",
  //    "authorization_servers":["https://amankesar.cloudflareaccess.com"]}
  //
  // and `https://amankesar.cloudflareaccess.com/cdn-cgi/access/certs` answers
  // 200 with the signing keys while `https://efb-live.cloudflareaccess.com/...`
  // answers 404. With `efb-live` here the JWKS fetch fails and every logged-in
  // request is answered 403 - including the owner's.
  "name": "efb-live-book",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  // The deploy builds the page first, whatever command it was reached by.
  //
  // `wrangler deploy` uploads `./dist` exactly as it finds it, and `main` here is the
  // Worker's own TypeScript, so a deploy run without a build ships the *old* bundle
  // beside the *new* Worker and nothing fails. That is not hypothetical: on 2026-10-29
  // the anchored panels were merged and deployed and the live page went on rendering
  // the nightly ones, because `dist/assets/index-CRtu51cm.js` was three days old. The
  // build is now part of the deploy, so there is no path that skips it.
  "build": {
    "command": "npx vite build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "r2_buckets": [{ "binding": "SNAPSHOTS", "bucket_name": "efb-snapshots" }],
  "vars": {
    // The switch that makes the page public: "true" serves the sanitized snapshot to
    // anyone, and anything else (unset, empty, a typo) demands the Access assertion as
    // before. It fails closed, which is why the value is a string compared exactly.
    "PUBLIC": "true",
    // Kept so a re-lock is a one-word change: set PUBLIC to "false", re-add the Access
    // application, and these are the two values the Worker verifies against.
    "ACCESS_TEAM_DOMAIN": "amankesar.cloudflareaccess.com",
    "ACCESS_AUD": "6d6b4aec421a3a0c13d54d45a7f6a6ad2bd0b1c75602fa88ba4f073b15908620"
  },
  "preview_urls": false,
  "observability": { "enabled": true }
}
