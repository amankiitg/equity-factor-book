  "criteria": {
    "F10.1": {
      "criterion": "Simulated drawdown distribution matches the analytical approximation within 10% at the median for the seed book's SR.",
      "threshold": "simulated median drawdown within 10% of the analytical value",
      "stored_numbers": {
        "simulated_median_drawdown": -0.14030834893682936,
        "analytical_median_drawdown": 0.0354329710482708,
        "relative_gap_at_median": 4.959824558479318,
        "n_bootstrap": 2000
      },
      "verdict": "fail",
      "note": "The analytical benchmark is the Magdon-Ismail infinite-horizon Brownian median, ln(2) sigma^2 / (2 mu), computed from the book's own annualized moments. The simulated median is the median maximum drawdown of block-bootstrapped paths of the book's net return series. The gap between the two measures the fat tails and volatility clustering the Brownian benchmark does not have."
    },
    "F10.2": {
      "criterion": "Control: on i.i.d. bootstrapped returns the stop-loss does not improve Sharpe. On the real book the result is reported either way.",
      "threshold": "stop-loss does not improve Sharpe on the i.i.d. control",
      "stored_numbers": {
        "control_mean_sharpe_diff": -0.487285170300088,
        "control_improves_sharpe": false,
        "seed_ew_real_sharpe_diff": 0.0,
        "seed_mom_ls_real_sharpe_diff": 0.22596605244168746
      },
      "verdict": "pass",
      "note": "On i.i.d. bootstrapped returns a drawdown stop can only truncate expected return, so it must not improve the mean Sharpe. The design book's control mean difference and the two seed books' real-book differences are stored; the real book is reported either way."
    },
    "F10.3": {
      "criterion": "Vol targeting reduces the dispersion of realized annual vol across years by more than 40%.",
      "threshold": "dispersion reduction above 40%",
      "stored_numbers": {
        "raw_dispersion": 0.2663475246430778,
        "targeted_dispersion": 0.2338401979010474,
        "dispersion_reduction": 0.12204854085125161,
        "n_years": 15
      },
      "verdict": "fail",
      "note": "The dispersion is the coefficient of variation of the realized annual volatility across years, measured before and after the trailing-window vol targeting scale. The targeting reduces the dispersion by only 12% at monthly frequency: the trailing 12-window volatility estimate lags and is noisy, so the targeting cannot remove the year-to-year dispersion the 40% threshold asks for."
    }
  },
