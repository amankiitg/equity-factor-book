  "criteria": {
    "F9.1": {
      "criterion": "Net Sharpe declines monotonically with AUM; the halving AUM is stored.",
      "threshold": "net Sharpe monotone in AUM; halving AUM stored",
      "stored_numbers": {
        "n_monotonicity_violations_net_sharpe": 206,
        "n_monotonicity_violations_net_mean": 0,
        "n_curves": 9,
        "halving_aum_by_rho_k": {
          "0.02_0.25": NaN,
          "0.02_0.5": NaN,
          "0.02_1.0": NaN,
          "0.05_0.25": NaN,
          "0.05_0.5": NaN,
          "0.05_1.0": NaN,
          "0.1_0.25": NaN,
          "0.1_0.5": NaN,
          "0.1_1.0": NaN
        }
      },
      "verdict": "fail",
      "note": "The net mean return declines monotonically in AUM (the impact grows with the square root of AUM), but the net Sharpe ratio does not: the impact cost's cross-rebalance variance grows with AUM and inflates the ratio's denominator, so the ratio rises toward zero. The criterion is written against the ratio, so it fails with that mechanism recorded. The halving AUM is undefined because the i.i.d. synthetic signal reshuffles the book fully each rebalance, leaving net Sharpe negative at every AUM: turnover, not capacity, is the binding constraint."
    },
    "F9.2": {
      "criterion": "The turnover-penalized optimizer cuts turnover by more than 50% with less than 20% loss of ex-ante IR.",
      "threshold": "turnover cut above 50%, IR loss below 20%",
      "stored_numbers": {
        "0.02": {
          "turnover_cut": 0.37549626103844624,
          "ex_ante_ir_loss": 0.06485377957194484
        },
        "0.05": {
          "turnover_cut": 0.3750665373197515,
          "ex_ante_ir_loss": 0.06475345564061231
        },
        "0.1": {
          "turnover_cut": 0.37538716626074037,
          "ex_ante_ir_loss": 0.0647444942254279
        }
      },
      "verdict": "fail",
      "note": "The penalized optimizer holds the low-alpha half of the book at its previous weight. It cuts about 37% of turnover with under 7% ex-ante IR loss, so the IR side of the criterion holds but the 50% turnover cut does not: the proportional book's turnover is concentrated in its high-alpha names, not in the low-alpha churn the criterion presumes."
    },
    "F9.3": {
      "criterion": "Corwin-Schultz spread estimates correlate above 0.5 with size rank (smaller names wider).",
      "threshold": "spread-size-rank correlation above 0.5",
      "stored_numbers": {
        "spread_size_rank_correlation": -0.349477497736197
      },
      "verdict": "fail",
      "note": "The Spearman correlation between the per-name half-spread and the size rank is negative (smaller names wider), and its magnitude is the scored number. It comes out below 0.5 because the Corwin-Schultz estimator is noisy at the single-name level, which is the failure mode the roadmap named; the decile means still decline monotonically from small to large."
    },
    "F9.4": {
