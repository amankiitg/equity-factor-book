# Python
__pycache__/
*.py[cod]
*$py.class
.venv
# a worktree's link to the shared virtualenv, which a bare `.venv` does match
.venv/
.venv*
venv
venv*
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Notebooks
.ipynb_checkpoints/
notebooks/**/*.html

# Data artifacts are rebuilt by make; VERSION.json is tracked
data/**/*.parquet
data/**/*.csv
data/**/*.feather
# Links to a data tree live outside the repo, and are never tracked. A link *at*
# `data` cannot be ignored without ignoring the tracked tree as well, so
# `make symlink-guard` refuses that one instead.
data-src*

# Restore dumps: the rows before an owner fix, which is book and account detail.
# The repo is public, so they live in ~/efb-backups/<date>/repo_backups/ with a
# manifest beside them, and an earlier copy is in the history only because it
# was committed before this line existed.
docs/owner_fixes/backups/

# Secrets and local config
.env
.env.*
!.env.example
.streamlit/credentials.toml

# Daily loop runtime state: decisions, positions, pnl and execution logs
# accumulate every trading day and are rebuilt by the jobs, not by git.
live/state/
live/logs/

# Copies of the sprint documents and notebooks served by the Methodology tab
dashboard/static/docs/

# The Cloudflare page's toolchain: dependencies, the built bundle, and wrangler's
# own scratch state. The lockfile IS committed, so the deploy build is the same
# tree every time.
web/node_modules/
web/dist/
web/.wrangler/
web/.vite/
*.tsbuildinfo

# OS
.DS_Store
